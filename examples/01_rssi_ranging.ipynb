      "source": [
        "from nl2t.core import rssi\n",
        "import numpy as np\n",
        "for d in [10.0, 100.0, 500.0, 1000.0, 2000.0]:\n",
        "    R = rssi.rssi(d)\n",
        "    print(f'd={d:6.1f}m  R={R:7.2f}dBm  d_est={rssi.range_from_rssi(R):7.2f}m')\n"
      ]
    }
