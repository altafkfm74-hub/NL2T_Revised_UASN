      "source": [
        "# CUSUM threshold\n",
        "\n",
        "Eq. threshold_derivation / threshold_computation."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from nl2t.core import cusum\n",
        "h = cusum.threshold(P_FA=1e-3, Delta=0.5, alpha=0.3, lam=2.0, sigma=1.0)\n",
        "print(f'h = {h:.4f}')  # expect ~5.62\n"
      ]
    }
  ],
